<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Tum yuzen navigasyon ogeleri (manevra karti, sokak pill'i, ETA karti)
         layout_nav_top icinde yerlesir. NavigationController nav_top_frame
         alt agacindaki ID'leri aradigi icin uyumlu calisir. -->
    <include layout="@layout/layout_nav_top" />

    <!-- Navigation Bottom Sheet Coordinator (Tam ekran kapsar, BottomSheet ve arka plan karartmasi yonetir) -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/nav_bottom_sheet_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Kart acildiginda gorunen ve haritaya tiklamayi engelleyip karti kapatan arka plan -->
        <View
            android:id="@+id/nav_bottom_sheet_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- ETA ve Navigasyon Kontrol Karti (Sol Altta 400dp genislikte ve yukarida) -->
        <FrameLayout
            android:id="@+id/nav_bottom_sheet"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="28dp"
            android:clickable="true"
            android:focusable="true"
            app:behavior_draggable="true"
            app:behavior_hideable="false"
            app:behavior_skipCollapsed="false"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <include layout="@layout/layout_nav_bottom" />
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation bar dummy view -->
    <View
        android:id="@+id/nav_bottom_sheet_nav_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />

</FrameLayout>

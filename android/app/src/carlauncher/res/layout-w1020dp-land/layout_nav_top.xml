<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_top_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Status bar dummy anchor for controller compatibility -->
    <FrameLayout
        android:id="@+id/statutbar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 1. SOL UST KOMPAKT MANEVRA KUTUSU (84dp): Donus oku + mesafe alt alta -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nav_card_maneuver"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_floating_card"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statutbar">

        <!-- nav_next_turn_frame hem oku hem mesafeyi kapsar (NavigationController uyumlu) -->
        <LinearLayout
            android:id="@+id/nav_next_turn_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Donus Oku ve Sonraki Donus Konteyniri -->
            <RelativeLayout
                android:id="@+id/nav_next_turn_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/turn_icon_box"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_nav_turn_icon"
                    android:gravity="center">

                    <app.organicmaps.widget.ArrowView
                        android:id="@+id/turn"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        app:tint="#38BDF8"
                        tools:src="@drawable/ic_turn_right" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/circle_exit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="3" />
                </FrameLayout>

                <!-- Sonraki sonraki donus ikonu (varsa) -->
                <FrameLayout
                    android:id="@+id/nav_next_next_turn_frame"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_below="@+id/turn_icon_box"
                    android:layout_alignStart="@+id/turn_icon_box"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_circle_car_button"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/turn"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        app:tint="#94A3B8"
                        tools:src="@drawable/ic_then_left_sharp" />
                </FrameLayout>
            </RelativeLayout>

            <!-- Mesafe: Orijinal Organic Maps gibi okun altinda net -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                tools:text="140 m" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. UST SOKAK SERIDI: Donus kutusunun hemen saginda baslar, sag butonlara kadar uzanir -->
    <LinearLayout
        android:id="@+id/street_frame"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_street_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="80dp"
        app:layout_constraintTop_toTopOf="@+id/nav_card_maneuver"
        app:layout_constraintStart_toEndOf="@+id/nav_card_maneuver"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/street"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            tools:text="Cahit Zarifoğlu Caddesi" />
    </LinearLayout>

    <!-- 3. SERIT REHBERI (Lanes): Cadde seridinin hemen altinda -->
    <app.organicmaps.widget.LanesView
        android:id="@+id/lanes"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/street_frame"
        app:layout_constraintStart_toStartOf="@+id/street_frame"
        app:layout_constraintEnd_toEndOf="@+id/street_frame"
        app:lanesActiveLaneTintColor="?navLaneArrowActiveColor"
        app:lanesInactiveLaneTintColor="?navLaneArrowInactiveColor"
        app:lanesBackgroundColor="?colorPrimary"
        app:lanesCornerRadius="6dp"
        tools:visibility="visible" />

    <!-- 4. SOL ALT KOMPAKT ETA & KONTROL DOCK'U (230dp): Ekranin altinda zarif mini-kart -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/nav_bottom_sheet_coordinator"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="9dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/nav_bottom_sheet_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/nav_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <include layout="@layout/layout_nav_bottom" />
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Dummy Invisible Speed Views for Controller Compatibility (Hiz gostergesi sag panelde aktiftir) -->
    <app.organicmaps.widget.CurrentSpeedView
        android:id="@+id/nav_current_speed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <app.organicmaps.widget.SpeedLimitView
        android:id="@+id/nav_speed_limit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

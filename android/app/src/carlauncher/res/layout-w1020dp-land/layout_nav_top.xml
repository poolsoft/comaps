<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_top_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Status bar dummy anchor for controller compatibility -->
    <FrameLayout
        android:id="@+id/statutbar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Kompakt Manevra Karti: donus oku + mesafe yanyana -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nav_card_maneuver"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_floating_card"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Donus Oku, Sonraki Donus ve Mesafe Konteyniri (nav_next_turn_frame hem oku hem mesafeyi kapsar) -->
        <LinearLayout
            android:id="@+id/nav_next_turn_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Donus Oku ve Sonraki Donus Konteyniri -->
            <RelativeLayout
                android:id="@+id/nav_next_turn_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/turn_icon_box"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nav_turn_icon"
                    android:gravity="center">

                    <app.organicmaps.widget.ArrowView
                        android:id="@+id/turn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        app:tint="#38BDF8"
                        tools:src="@drawable/ic_turn_right" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/circle_exit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="3" />
                </FrameLayout>

                <!-- Sonraki sonraki donus ikonu (varsa) -->
                <FrameLayout
                    android:id="@+id/nav_next_next_turn_frame"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_below="@+id/turn_icon_box"
                    android:layout_alignStart="@+id/turn_icon_box"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_circle_car_button"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/turn"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        app:tint="#94A3B8"
                        tools:src="@drawable/ic_then_left_sharp" />
                </FrameLayout>
            </RelativeLayout>

            <!-- Donus Mesafesi -->
            <LinearLayout
                android:id="@+id/turn_details_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <!-- Mesafe (NavigationController: turnFrame.findViewById(R.id.distance)) -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    tools:text="140 m" />
            </LinearLayout>
        </LinearLayout>

        <!-- Serit Rehberi (Lanes) -->
        <app.organicmaps.widget.LanesView
            android:id="@+id/lanes"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/nav_next_turn_frame"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:lanesActiveLaneTintColor="?navLaneArrowActiveColor"
            app:lanesInactiveLaneTintColor="?navLaneArrowInactiveColor"
            app:lanesBackgroundColor="?colorPrimary"
            app:lanesCornerRadius="6dp"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Alt Ortada Yuzen Sokak Adi Pill'i (street ID'si NavigationController uyumlu) -->
    <LinearLayout
        android:id="@+id/street_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_street_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.42"
        android:layout_marginBottom="20dp"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/street"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="360dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            tools:text="Emniyet Caddesi" />
    </LinearLayout>

    <!-- ETA, Sure, Mesafe ve Kontrol Karti (manevra kartinin altinda) -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/nav_bottom_sheet_coordinator"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="9dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nav_card_maneuver">

        <View
            android:id="@+id/nav_bottom_sheet_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/nav_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <include layout="@layout/layout_nav_bottom" />
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Dummy Invisible Speed Views for Controller Compatibility (Hiz gostergesi sag panelde aktiftir) -->
    <app.organicmaps.widget.CurrentSpeedView
        android:id="@+id/nav_current_speed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <app.organicmaps.widget.SpeedLimitView
        android:id="@+id/nav_speed_limit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cl_background_deep">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ANTEN HÄ°ZALAMA"
            android:textColor="@color/cl_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/cl_text_primary"/>
    </LinearLayout>

    <!-- Main Visualizer (AlignmentView) -->
    <app.organicmaps.carlauncher.antenna.AlignmentView
        android:id="@+id/alignment_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        app:layout_constraintBottom_toTopOf="@+id/card_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header" />

    <!-- Current Stats Overlay (Pusula Ortasindaki Yazilar) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/alignment_view"
        app:layout_constraintEnd_toEndOf="@+id/alignment_view"
        app:layout_constraintStart_toStartOf="@+id/alignment_view"
        app:layout_constraintTop_toTopOf="@+id/alignment_view">

        <TextView
            android:id="@+id/text_current_azimuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YÃ¶n: 0.0Â°"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_current_pitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EÄŸim: 0.0Â°"
            android:textColor="@android:color/holo_green_light"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Target Info Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/cl_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEDEF VERÄ°LERÄ°"
                android:textColor="@color/cl_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/text_target_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="KAYNAK -> HEDEF\nAzimut 0.0Â° | EÄŸim 0.0Â°"
                android:textColor="@color/cl_text_primary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

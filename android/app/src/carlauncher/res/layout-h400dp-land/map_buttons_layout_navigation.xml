<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/map_buttons_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Dokunma yakalayıcı (Gerektiğinde harita etkileşimini durdurmak için) -->
    <View
        android:id="@+id/touch_interceptor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Anchor Frame for Compatibility -->
    <FrameLayout
        android:id="@+id/map_buttons_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 1. SAĞ ÜST KONTROL GRUBU: [ Ara ] [ Katmanlar ] [ Ayarlar ] -->
    <LinearLayout
        android:id="@+id/top_right_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1.A. Arama Butonu (Navigasyonda gizli) -->
        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- 1.B. Katman Butonu (Navigasyonda tek basina sag ustte) -->
        <app.organicmaps.maplayer.LayersButton
            android:id="@+id/layers_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_car_button"
            app:backgroundTint="@null"
            app:borderWidth="0dp"
            app:elevation="4dp"
            app:maxImageSize="22dp"
            android:src="@drawable/ic_layers"
            app:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:contentDescription="@string/layers_title" />

        <!-- 1.C. Menü / Ayarlar Butonu (Navigasyonda sol altta var, burada gizli) -->
        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Kayit Durumu -->
    <include
        layout="@layout/map_status_track_recording"
        android:id="@+id/track_recording_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. SAĞ ORTA GRUP: Canli Hiz/Limit + Zoom (+/-) Kapsulu -->
    <LinearLayout
        android:id="@+id/map_buttons_inner_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="10dp"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@+id/top_right_controls"
        app:layout_constraintBottom_toTopOf="@+id/map_buttons_bottom"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 2.A. Hiz Limiti Tabelasi (Haritada hiz siniri varsa belirir) -->
        <FrameLayout
            android:id="@+id/speed_limit_container"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <app.organicmaps.widget.SpeedLimitView
                android:id="@+id/speed_limit"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- 2.B. Canli Hiz Gostergesi Kapsulu (kompakt: 52dp) -->
        <FrameLayout
            android:id="@+id/speed_capsule_container"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_circle_car_button">

            <app.organicmaps.widget.CurrentSpeedView
                android:id="@+id/current_speed"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:visibility="visible" />
        </FrameLayout>

        <!-- 2.B. Dikey Zoom Kapsulu: [ + ] ve [ - ] (kompakt: 42x88dp) -->
        <LinearLayout
            android:id="@+id/zoom_buttons_container"
            android:layout_width="42dp"
            android:layout_height="88dp"
            android:orientation="vertical"
            android:background="@drawable/bg_zoom_capsule"
            android:gravity="center"
            android:elevation="4dp">

            <!-- Zoom In (+) -->
            <ImageView
                android:id="@+id/nav_zoom_in"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:src="@drawable/ic_plus"
                app:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/zoom_in" />

            <View
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:background="#33FFFFFF" />

            <!-- Zoom Out (-) -->
            <ImageView
                android:id="@+id/nav_zoom_out"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:src="@drawable/ic_minus"
                app:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/zoom_out" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. SAĞ ALT İŞLEM BUTONLARI: [ Favoriler ] [ Rota ] [ GPS Odaklan ] -->
    <LinearLayout
        android:id="@+id/map_buttons_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 3.A. Favoriler Butonu (Navigasyonda gizli) -->
        <ImageButton
            android:id="@+id/btn_bookmarks"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- 3.B. Rota Butonu (Navigasyonda gizli) -->
        <ImageButton
            android:id="@+id/btn_route"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- 3.C. GPS Konum Odaklan Butonu (my_position) -->
        <include
            layout="@layout/map_buttons_myposition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Invisible Dummy Left Container for Controller Compatibility -->
    <FrameLayout
        android:id="@+id/map_buttons_inner_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
